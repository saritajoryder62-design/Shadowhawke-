# Template for .env. Copy this file to .env and fill in real values there, never here.
# This file is committed to git, so it must only ever contain blank values.
#
# Nothing on the website reads these. The site is plain HTML, and Netlify Forms
# needs no keys. They are only for deploying from the terminal with the Netlify CLI,
# or for serverless functions if any are added later.

# Netlify personal access token: Netlify > User settings > Applications > Personal access tokens
NETLIFY_AUTH_TOKEN=

# Netlify site ID: Netlify > Site configuration > General > Site details
NETLIFY_SITE_ID=
